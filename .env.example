# Vercel Blob (persistência do estado e dos usuários)
BLOB_READ_WRITE_TOKEN=

# Segredo para assinar o cookie de sessão (HMAC). Gere um valor longo aleatório.
AUTH_SECRET=

# Claude (classificação de lançamentos + sugestão de orçamento)
ANTHROPIC_API_KEY=

# Safragold — credenciais de acesso aos lançamentos conciliados.
# Preencher assim que descobrirmos COMO o Safragold entrega os dados
# (API REST? banco? export?). Ver api/safragold-sync.ts.
SAFRAGOLD_BASE_URL=
SAFRAGOLD_API_KEY=
